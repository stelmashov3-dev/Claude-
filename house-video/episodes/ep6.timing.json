 "cues": [
  {
   "t0": 0.9,
   "t1": 5.577,
   "text": "Серия шестая, заключительная. Окна, двери и фасад."
  },
  {
   "t0": 5.927,
   "t1": 10.018,
   "text": "Закрываем тепловой контур дома и делаем его красивым."
  },
  {
   "t0": 12.018,
   "t1": 16.847,
   "text": "Устанавливаем окна. Монтажный шов заполняем пеной и защищаем"
  },
  {
   "t0": 16.847,
   "t1": 21.595,
   "text": "лентами: снаружи паропроницаемой, изнутри пароизоляционной."
  },
  {
   "t0": 21.945,
   "t1": 24.978,
   "text": "Входную дверь ставим с утеплённым порогом."
  },
  {
   "t0": 26.278,
   "t1": 30.787,
   "text": "Фасад утепляем плитами каменной ваты толщиной сто миллиметров."
  },
  {
   "t0": 30.787,
   "t1": 34.86,
   "text": "Плиты сажаем на клей и дополнительно крепим тарельчатыми"
  },
  {
   "t0": 34.86,
   "t1": 35.515,
   "text": "дюбелями."
  },
  {
   "t0": 36.815,
   "t1": 41.918,
   "text": "Поверх утеплителя — армирующая сетка и тонкослойная декоративная"
  },
  {
   "t0": 41.918,
   "t1": 45.746,
   "text": "штукатурка. Такой фасад дышит и не боится влаги."
  },
  {
   "t0": 47.046,
   "t1": 51.738,
   "text": "Убираем строительный мусор, планируем участок, укладываем"
  },
  {
   "t0": 51.738,
   "t1": 53.466,
   "text": "дорожку и сеем газон."
  },
  {
   "t0": 55.216,
   "t1": 60.41,
   "text": "Дом построен. От подсыпки участка до готового фасада, шаг за"
  },
  {
   "t0": 60.41,
   "t1": 60.929,
   "text": "шагом."
  },
  {
   "t0": 61.279,
   "t1": 63.325,
   "text": "Спасибо, что смотрели!"
  }
 ]
}