 ],
 "cues": [
  {
   "t0": 0.9,
   "t1": 5.076,
   "text": "Серия третья. Гидроизоляция и утепление фундамента."
  },
  {
   "t0": 5.426,
   "t1": 9.96,
   "text": "Бетон набрал прочность, и теперь его нужно защитить от воды и"
  },
  {
   "t0": 9.96,
   "t1": 10.481,
   "text": "холода."
  },
  {
   "t0": 12.481,
   "t1": 17.751,
   "text": "Снимаем щиты опалубки и откапываем пазухи, чтобы открыть внешние"
  },
  {
   "t0": 17.751,
   "t1": 18.821,
   "text": "стенки ленты."
  },
  {
   "t0": 20.121,
   "t1": 25.095,
   "text": "Боковые поверхности покрываем битумной мастикой в два слоя. Она"
  },
  {
   "t0": 25.095,
   "t1": 27.779,
   "text": "защищает бетон от грунтовой влаги."
  },
  {
   "t0": 29.079,
   "t1": 33.297,
   "text": "Поверх мастики клеим плиты экструдированного пенополистирола"
  },
  {
   "t0": 33.297,
   "t1": 35.055,
   "text": "толщиной сто миллиметров."
  },
  {
   "t0": 35.405,
   "t1": 39.969,
   "text": "Они не дают фундаменту промерзать и снижают теплопотери дома."
  },
  {
   "t0": 41.269,
   "t1": 46.295,
   "text": "Пазухи засыпаем песком и послойно уплотняем. Внутри ленты тоже"
  },
  {
   "t0": 46.295,
   "t1": 48.565,
   "text": "засыпаем до уровня площадки."
  },
  {
   "t0": 49.865,
   "t1": 54.969,
   "text": "По верху ленты наплавляем рулонную гидроизоляцию в два слоя. Она"
  },
  {
   "t0": 54.969,
   "t1": 59.674,
   "text": "отсекает капиллярную влагу, и стены всегда остаются сухими."
  },
  {
   "t0": 61.424,
   "t1": 65.861,
   "text": "Нулевой цикл завершён. В следующей серии возводим стены из"
  },
  {
   "t0": 65.861,
   "t1": 66.703,
   "text": "газобетона."
  }
 ]
}