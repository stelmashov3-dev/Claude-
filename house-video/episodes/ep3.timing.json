 ],
 "cues": [
  {
   "t0": 0.9,
   "t1": 3.292,
   "text": "Бетон крепкий, но у него два врага: вода и мороз."
  },
  {
   "t0": 3.642,
   "t1": 6.902,
   "text": "Сегодня рассказываем, как мы от них защищаемся."
  },
  {
   "t0": 8.902,
   "t1": 12.389,
   "text": "Снимаем опалубку и откапываем пазухи, чтобы добраться до стенок"
  },
  {
   "t0": 12.389,
   "t1": 12.721,
   "text": "ленты."
  },
  {
   "t0": 14.021,
   "t1": 17.098,
   "text": "Стенки промазываем битумной мастикой в два слоя. Теперь"
  },
  {
   "t0": 17.098,
   "t1": 18.943,
   "text": "грунтовая вода бетону не страшна."
  },
  {
   "t0": 20.243,
   "t1": 23.672,
   "text": "Сверху клеим плиты пенополистирола толщиной десять сантиметров."
  },
  {
   "t0": 24.022,
   "t1": 27.468,
   "text": "Фундамент не промерзает, а в доме теплее и меньше счета за"
  },
  {
   "t0": 27.468,
   "t1": 28.062,
   "text": "отопление."
  },
  {
   "t0": 29.362,
   "t1": 33.623,
   "text": "Засыпаем пазухи песком и уплотняем слоями. Внутри ленты тоже."
  },
  {
   "t0": 34.923,
   "t1": 38.323,
   "text": "По верху ленты наплавляем гидроизоляцию в два слоя. Влага снизу"
  },
  {
   "t0": 38.323,
   "t1": 39.996,
   "text": "в стены не поднимется. Никогда!"
  },
  {
   "t0": 41.746,
   "t1": 45.392,
   "text": "Нулевой цикл готов! Дальше самое интересное: дом начинает расти."
  },
  {
   "t0": 45.392,
   "t1": 46.816,
   "text": "Смотрите четвёртую серию!"
  }
 ]
}