 "cues": [
  {
   "t0": 0.9,
   "t1": 2.603,
   "text": "Серия пятая. Кровля."
  },
  {
   "t0": 2.953,
   "t1": 8.266,
   "text": "Двускатная крыша защищает дом от дождя и снега, а её основа —"
  },
  {
   "t0": 8.266,
   "t1": 10.008,
   "text": "стропильная система."
  },
  {
   "t0": 12.008,
   "t1": 16.734,
   "text": "Сначала выкладываем фронтоны и крепим к армопоясу мауэрлат:"
  },
  {
   "t0": 16.734,
   "t1": 20.498,
   "text": "деревянный брус, на который опираются стропила."
  },
  {
   "t0": 21.798,
   "t1": 26.613,
   "text": "Стропила ставим с шагом шестьсот миллиметров. Каждую ногу крепим"
  },
  {
   "t0": 26.613,
   "t1": 29.321,
   "text": "к мауэрлату металлическими уголками."
  },
  {
   "t0": 30.621,
   "t1": 35.312,
   "text": "Поверх стропил раскатываем ветро-влагозащитную мембрану. Она"
  },
  {
   "t0": 35.312,
   "t1": 39.455,
   "text": "выпускает пар изнутри, но не пропускает воду снаружи."
  },
  {
   "t0": 40.755,
   "t1": 45.022,
   "text": "Сверху набиваем контробрешётку и обрешётку: они создают"
  },
  {
   "t0": 45.022,
   "t1": 48.668,
   "text": "вентиляционный зазор и держат кровельные листы."
  },
  {
   "t0": 49.968,
   "t1": 54.368,
   "text": "Листы металлочерепицы монтируем от торца, внахлёст, на"
  },
  {
   "t0": 54.368,
   "t1": 57.219,
   "text": "кровельные саморезы с уплотнителем."
  },
  {
   "t0": 58.519,
   "t1": 63.028,
   "text": "Последним ставим конёк. Кровля закрыта, и дом защищён от"
  },
  {
   "t0": 63.028,
   "t1": 63.672,
   "text": "осадков."
  },
  {
   "t0": 65.422,
   "t1": 70.838,
   "text": "Дом под крышей. В заключительной серии — окна, двери и утепление"
  },
  {
   "t0": 70.838,
   "t1": 71.431,
   "text": "фасада."
  }
 ]
}