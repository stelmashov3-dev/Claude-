 "cues": [
  {
   "t0": 0.9,
   "t1": 4.405,
   "text": "Финальная серия! Окна, фасад и момент, ради которого всё"
  },
  {
   "t0": 4.405,
   "t1": 5.093,
   "text": "затевалось."
  },
  {
   "t0": 7.093,
   "t1": 10.699,
   "text": "Ставим тёплые окна. Шов запениваем и закрываем лентами, чтобы не"
  },
  {
   "t0": 10.699,
   "t1": 11.882,
   "text": "дуло и не промерзало."
  },
  {
   "t0": 12.232,
   "t1": 14.101,
   "text": "И входная дверь с утеплённым порогом."
  },
  {
   "t0": 15.401,
   "t1": 19.214,
   "text": "Фасад утепляем каменной ватой, десять сантиметров. Плиты на клей"
  },
  {
   "t0": 19.214,
   "t1": 19.929,
   "text": "и на дюбели."
  },
  {
   "t0": 21.229,
   "t1": 24.888,
   "text": "Сверху сетка и декоративная штукатурка. Дом становится красивым,"
  },
  {
   "t0": 24.888,
   "t1": 26.202,
   "text": "и стены при этом дышат."
  },
  {
   "t0": 27.502,
   "t1": 30.927,
   "text": "Убираем мусор, ровняем участок, кладём дорожку и сеем газон."
  },
  {
   "t0": 32.677,
   "t1": 36.609,
   "text": "Вот он, ваш дом. От подсыпки участка до готового фасада, шаг за"
  },
  {
   "t0": 36.609,
   "t1": 36.984,
   "text": "шагом."
  },
  {
   "t0": 37.334,
   "t1": 39.505,
   "text": "Хотите так же? Пишите нам, построим!"
  }
 ]
